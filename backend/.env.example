# Copy this file to backend/.env and fill in your real values.
# This file contains NO secrets — safe to commit.

# ── Groq API ──────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── URLs ──────────────────────────────────────────────────────────────────────
# Production frontend origin — used by backend CORS config.
# Set this as an environment variable in your Render dashboard instead of here.
FRONTEND_URL=https://www.ravenprompt.tech

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
